# Copy to .env only on the server. Never commit the populated file.
AI_PLATFORM_ROOT=/mnt/Storage1/ai-platform
TZ=America/Los_Angeles

# Released image pins verified 2026-11-18.
OLLAMA_VERSION=0.40.16
LITELLM_VERSION=1.108.11
OPEN_WEBUI_VERSION=0.13.4
SEARXNG_VERSION=2026.11.13-8a53a6aa5
CADDY_VERSION=2.11.9-alpine
OPENHANDS_VERSION=1.41.0
SWITCH_VERSION=0.32.1
OPENCODE_VERSION=2.2.7
N8N_VERSION=2.48.5

# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=
WEBUI_SECRET_KEY=
SEARXNG_SECRET=
LOCAL_BACKEND_API_KEY=
OH_SECRET_KEY=
AUTOMATION_KV_SECRET=

# Optional frontier route. Leave both blank to keep it disabled.
OPENAI_API_KEY=
FRONTIER_CODE_MODEL=

# Permanent Switch identity. Choose before the first Switch start; never rename it.
SWITCH_SERVER_NAME=
SWITCH_DB_USER=switch_app
SWITCH_DB_PASSWORD=
SWITCH_DB_OWNER_USER=postgres
SWITCH_DB_OWNER_PASSWORD=
SWITCH_DB_NAME=switch
SWITCH_AGENT_REGISTRATION_TOKEN=
SWITCH_SECRET_KEYS=
SWITCH_CONTROLLER_TOKEN_SECRET=
SWITCH_ADMIN_EMAIL=
SWITCH_ADMIN_PASSWORD=
SWITCH_FRONTEND_BASE_URL=
SWITCH_GATEWAY_PUBLIC_URL=

# A separate new Discord application for Switch. Keep blank until Phase 4.
SWITCH_DISCORD_CLIENT_ID=
SWITCH_DISCORD_CLIENT_SECRET=
SWITCH_DISCORD_BOT_TOKEN=
SWITCH_DISCORD_APPLICATION_ID=

# Explicit host paths. Never point these at /home or /mnt/Storage1 as a whole.
OPENHANDS_PROJECTS_PATH=/mnt/Storage1/ai-platform/workspaces/openhands

# Internal names resolved by Pi-hole or another trusted resolver.
OPEN_WEBUI_HOST=ai.home
SWITCH_HOST=switch.home
OPENHANDS_HOST=openhands.home

