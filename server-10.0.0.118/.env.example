# Copy to server-10.0.0.118/.env on the server (never commit the real .env).
# docker compose reads it for ${LITELLM_MASTER_KEY}; devbot loads it via env_file.

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
# Your own user ID (Discord settings > Advanced > Developer Mode, then right-click yourself > Copy User ID)
DISCORD_OWNER_ID=
# Right-click your server icon > Copy Server ID
DISCORD_GUILD_ID=
# Right-click #general > Copy Channel ID (scheduled check-in / wrap-up / retro posts)
DISCORD_CHANNEL_ID=

# --- LiteLLM proxy (internal only; any long random string) ---
# e.g. generate with: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-change-me

# --- Phase 2: Notion (https://www.notion.so/my-integrations) ---
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=

# --- Phase 3/4: GitHub fine-grained token (selected repos; Contents + Pull requests: read/write) ---
GITHUB_TOKEN=

# Rootless Docker is the required isolation boundary for repository verification.
# Install it for uid 1000; never point this at the rootful /var/run/docker.sock.
VERIFIER_DOCKER_HOST=unix:///run/rootless-docker/docker.sock
VERIFIER_HOST_DATA_DIR=/mnt/Storage1/devbot
