{
  "id": "BPEspgHUwTOYLh6k",
  "name": "1. Daily AI Tech & News Digest -> Discord",
  "nodes": [
    {
      "parameters": {},
      "id": "b1a10001-0001-4000-8000-000000000001",
      "name": "Click 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 240]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "b1a10001-0001-4000-8000-000000000002",
      "name": "Every Morning at 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 420]
    },
    {
      "parameters": {
        "url": "https://hnrss.org/frontpage?count=8",
        "options": {}
      },
      "id": "b1a10001-0001-4000-8000-000000000003",
      "name": "Fetch Top Tech News (RSS)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [460, 320]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().slice(0, 8);\nconst listText = items.map((item, idx) => `${idx + 1}. ${item.json.title} (${item.json.link})`).join('\\n');\n\nreturn [{\n  json: {\n    stories: listText,\n    ollamaBody: {\n      model: 'qwen2.5:3b',\n      stream: false,\n      prompt: `You are a concise morning tech briefing assistant. Below are today's top stories:\\n\\n${listText}\\n\\nPick the 5 most interesting stories and write a short, punchy bulleted morning digest. Include the markdown link [Title](URL) for each bullet and a 1-sentence explanation of why it matters. Keep total length under 1500 characters.`\n    }\n  }\n}];"
      },
      "id": "b1a10001-0001-4000-8000-000000000004",
      "name": "Build Prompt from Stories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ollamaBody) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "b1a10001-0001-4000-8000-000000000005",
      "name": "Summarize with Local Ollama (qwen2.5:3b)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response || 'No summary generated.';\nconst header = '☀️ **Daily Morning AI Tech Digest**\\n\\n';\nconst content = (header + raw).slice(0, 1950);\nreturn [{ json: { content, discordWebhookUrl: 'https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN' } }];"
      },
      "id": "b1a10001-0001-4000-8000-000000000006",
      "name": "Format for Discord",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: 'Homelab AI Digest', content: $json.content }) }}",
        "options": {}
      },
      "id": "b1a10001-0001-4000-8000-000000000007",
      "name": "Post to Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 320]
    }
