{
  "id": "ArxivPaperDigest",
  "name": "4. Master's CS & AI ArXiv Paper Digest -> Discord",
  "nodes": [
    {
      "parameters": {},
      "id": "d4a40001-0001-4000-8000-000000000001",
      "name": "Click 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 240]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "d4a40001-0001-4000-8000-000000000002",
      "name": "Weekdays at 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 420]
    },
    {
      "parameters": {
        "url": "https://rss.arxiv.org/rss/cs.AI+cs.LG+cs.SE",
        "options": {}
      },
      "id": "d4a40001-0001-4000-8000-000000000003",
      "name": "Fetch ArXiv CS.AI + CS.LG + CS.SE",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [460, 320]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().slice(0, 6);\nconst papers = items.map((item, idx) => {\n  const snippet = (item.json.contentSnippet || item.json.content || '').replace(/\\s+/g, ' ').slice(0, 350);\n  return `${idx + 1}. ${item.json.title}\\n   URL: ${item.json.link}\\n   Abstract: ${snippet}`;\n}).join('\\n\\n');\n\nreturn [{\n  json: {\n    papers,\n    ollamaBody: {\n      model: 'qwen2.5:3b',\n      stream: false,\n      prompt: `You are a graduate CS research assistant. Below are today's new ArXiv papers in AI, Machine Learning, and Software Engineering:\\n\\n${papers}\\n\\nPick the 4 most interesting papers. For each paper, provide a bullet point with the markdown link [Title](URL), a 1-sentence plain-English summary of the method/finding, and a 1-sentence takeaway for a CS Master's student or AI builder. Keep total output under 1500 characters.`\n    }\n  }\n}];"
      },
      "id": "d4a40001-0001-4000-8000-000000000004",
      "name": "Build ArXiv Digest Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ollamaBody) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "d4a40001-0001-4000-8000-000000000005",
      "name": "Summarize Papers with Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response || 'No papers summarized.';\nconst header = '🎓 **Master\\'s CS & AI ArXiv Paper Digest**\\n\\n';\nconst content = (header + raw).slice(0, 1950);\nreturn [{ json: { content, discordWebhookUrl: 'https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN' } }];"
      },
      "id": "d4a40001-0001-4000-8000-000000000006",
      "name": "Format Paper Digest for Discord",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: 'ArXiv Research Assistant', content: $json.content }) }}",
        "options": {}
      },
      "id": "d4a40001-0001-4000-8000-000000000007",
      "name": "Post ArXiv Digest to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 320]
    }
  ],
