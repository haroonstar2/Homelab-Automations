{
  "id": "JobHuntRadar2026",
  "name": "3. SWE & AI Job Hunt Radar -> Discord",
  "nodes": [
    {
      "parameters": {},
      "id": "c3a30001-0001-4000-8000-000000000001",
      "name": "Click 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 240]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10,16 * * *"
            }
          ]
        }
      },
      "id": "c3a30001-0001-4000-8000-000000000002",
      "name": "Every Day at 10 AM & 4 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 420]
    },
    {
      "parameters": {
        "url": "https://hnrss.org/jobs?count=12",
        "options": {}
      },
      "id": "c3a30001-0001-4000-8000-000000000003",
      "name": "Fetch YC / Tech Job Postings",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [460, 320]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().slice(0, 12);\nconst jobsList = items.map((item, idx) => `${idx + 1}. ${item.json.title}\\n   Apply URL: ${item.json.link}\\n   Published: ${item.json.pubDate || ''}`).join('\\n\\n');\n\nreturn [{\n  json: {\n    jobsList,\n    ollamaBody: {\n      model: 'qwen2.5:3b',\n      stream: false,\n      prompt: `You are a career scout helping a CS Master's student and SaaS builder find Software Engineering, AI/ML, Full-Stack, and Backend jobs. Below are the latest tech job postings:\\n\\n${jobsList}\\n\\nSelect up to 5 of the best Software/AI/Engineering roles. Format each as a bullet point with a clickable markdown link [Company / Role Title](Apply URL) and 1 short sentence on what they are looking for. Keep total output under 1500 characters.`\n    }\n  }\n}];"
      },
      "id": "c3a30001-0001-4000-8000-000000000004",
      "name": "Prepare Job Filter Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.ollamaBody) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "c3a30001-0001-4000-8000-000000000005",
      "name": "Rank & Filter Jobs with Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response || 'No matching jobs found.';\nconst header = '💼 **SWE & AI Job Hunt Radar**\\n\\n';\nconst content = (header + raw).slice(0, 1950);\nreturn [{ json: { content, discordWebhookUrl: 'https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN' } }];"
      },
      "id": "c3a30001-0001-4000-8000-000000000006",
      "name": "Format Job Alert for Discord",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: 'Homelab Job Scout', content: $json.content }) }}",
        "options": {}
      },
      "id": "c3a30001-0001-4000-8000-000000000007",
      "name": "Post Jobs to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 320]
    }
  ],
  "connections": {
