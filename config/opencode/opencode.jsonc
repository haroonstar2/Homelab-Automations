{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/local-code",
  "providers": {
    "litellm": {
      "name": "Private LiteLLM",
      "env": ["LITELLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:14000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "local-code": {
          "modelID": "local-code",
          "name": "Local Code",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "local-fast": {
          "modelID": "local-fast",
          "name": "Local Fast",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}

